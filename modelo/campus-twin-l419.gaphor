<SysML:Requirement id="f4f51b22-ace7-11f1-b6dd-fab8722d731b">
<externalId>
<val>NS-1</val>
</externalId>
<name>
<val>Ronda informada</val>
</name>
<owningPackage>
<ref refid="f4f517a8-ace7-11f1-b6dd-fab8722d731b"/>
</owningPackage>
<presentation>
<reflist>
<ref refid="f567e274-ace7-11f1-b6dd-fab8722d731b"/>
<ref refid="f56f43ac-ace7-11f1-b6dd-fab8722d731b"/>
<ref refid="f591488a-ace7-11f1-b6dd-fab8722d731b"/>
</reflist>
</presentation>
<text>
<val>El vigilante nocturno necesita conocer el estado del laboratorio durante su ronda sin cargar una laptop.</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="f4f51d16-ace7-11f1-b6dd-fab8722d731b">
<externalId>
<val>NS-2</val>
</externalId>
<name>
<val>Consumo bajo control</val>
</name>
<owningPackage>
<ref refid="f4f517a8-ace7-11f1-b6dd-fab8722d731b"/>
