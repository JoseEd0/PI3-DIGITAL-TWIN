  edge [color="#555555", arrowsize=0.7];
  "actividad_grupal" [label="Actividad grupal con mucha gente\n[salida OR] · observable: MLX90640 (nodo 5)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "equipos_ruidosos" [label="Equipo con ruido mecánico constante (aire, proyector)\n[salida OR] · observable: INMP441 (nodo 2)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "ruido_exterior" [label="Ruido del pasillo con la puerta abierta\n[salida OR] · observable: KY-024 (nodo 6)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "impactos" [label="Golpes o portazos\n[salida OR] · observable: INMP441 (nodo 2)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
