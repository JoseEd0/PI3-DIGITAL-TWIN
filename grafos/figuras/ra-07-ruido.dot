  "baja_inteligibilidad" [label="No se entiende al docente\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "estres" [label="Estrés y fatiga auditiva\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "actividad_grupal" -> "ruido_excesivo";
  "equipos_ruidosos" -> "ruido_excesivo";
  "ruido_exterior" -> "ruido_excesivo";
  "impactos" -> "ruido_excesivo";
  "ruido_excesivo" -> "baja_inteligibilidad";
  "ruido_excesivo" -> "estres";
}