digraph "ra-01-temperatura" {
  rankdir=LR; splines=true; nodesep=0.25; ranksep=0.5;
  label="RA-01 · Temperatura fuera de la zona de confort"; labelloc=t; fontsize=18; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.7];
  "calor_exterior" [label="Temperatura exterior alta (verano de Lima)\n[salida OR] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "sol_directo" [label="Radiación solar directa por las ventanas\n[salida OR] · observable: BH1750 (nodo 4)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "ocupacion_alta" [label="Muchas personas en el aula (≥ 50 % del aforo)\n[salida OR] · observable: MLX90640 (nodo 5)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "puerta_cerrada_prolongada" [label="Puerta cerrada más de 30 min con gente dentro\n[salida OR] · observable: KY-024 (nodo 6)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "aire_apagado_o_averiado" [label="Aire acondicionado apagado o sin enfriar\n[salida OR] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "equipos_encendidos" [label="Muchos equipos encendidos (PC, proyector)\n[salida OR] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "aire_setpoint_bajo" [label="Aire acondicionado con temperatura muy baja\n[salida OR] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "aire_sin_ocupacion" [label="Aire encendido con el aula vacía\n[salida OR] · observable: INMP441 (nodo 2) + MLX90640 (nodo 5)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "ventilacion_insuficiente" [label="Ventilación o enfriamiento insuficiente\n[OR-OR] · inferido", fillcolor="#ffffff", style="rounded,filled,dashed", penwidth=1];
  "carga_termica_interna" [label="Carga térmica interna alta\n[OR-OR] · inferido", fillcolor="#ffffff", style="rounded,filled,dashed", penwidth=1];
  "temperatura_alta" [label="Temperatura > 26 °C\n[OR-OR] · observable: BME280 (nodo 7)", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "temperatura_baja" [label="Temperatura < 20 °C\n[OR-OR] · observable: BME280 (nodo 7)", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "violacion_confort" [label="RA-01 violado: temperatura fuera de 20–26 °C\n[OR-OR] · observable: ", fillcolor="#f8c9c9", style="rounded,filled,bold", penwidth=3];
  "somnolencia" [label="Ocupantes somnolientos y menor rendimiento\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "golpe_de_calor" [label="Riesgo de golpe de calor\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "mas_consumo_climatizacion" [label="Más consumo de climatización\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "incomodidad_por_frio" [label="Incomodidad por frío\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "energia_desperdiciada" [label="Energía desperdiciada\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "calor_exterior" -> "temperatura_alta";
  "sol_directo" -> "temperatura_alta";
  "ocupacion_alta" -> "carga_termica_interna";
  "puerta_cerrada_prolongada" -> "ventilacion_insuficiente";
  "aire_apagado_o_averiado" -> "ventilacion_insuficiente";
  "equipos_encendidos" -> "carga_termica_interna";
  "aire_setpoint_bajo" -> "temperatura_baja";
  "aire_sin_ocupacion" -> "temperatura_baja";
  "aire_sin_ocupacion" -> "energia_desperdiciada";
  "ventilacion_insuficiente" -> "temperatura_alta";
  "carga_termica_interna" -> "temperatura_alta";
  "temperatura_alta" -> "violacion_confort";
  "temperatura_alta" -> "somnolencia";
  "temperatura_alta" -> "golpe_de_calor";
  "temperatura_alta" -> "mas_consumo_climatizacion";
  "temperatura_baja" -> "violacion_confort";
  "temperatura_baja" -> "incomodidad_por_frio";
}