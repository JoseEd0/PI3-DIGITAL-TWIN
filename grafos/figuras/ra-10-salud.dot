digraph "ra-10-salud" {
  rankdir=LR; splines=true; nodesep=0.25; ranksep=0.5;
  label="RA-10 · Salud del sistema de medición"; labelloc=t; fontsize=18; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.7];
  "gateway_caido" [label="Gateway caído o sin Wi-Fi\n[salida AND] · observable: LWT del Gateway (utec/gemelo/<grupo>/gateway/estado)", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "canal_espnow" [label="Interferencia o canal ESP-NOW distinto al del router\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "falla_de_sensor" [label="Algún sensor reporta FALLO_SENSOR\n[salida OR] · observable: bits de anomalía de los nodos", fillcolor="#fde2c4", style="rounded,filled,bold", penwidth=2];
  "nodo1_apagado" [label="Nodo 1 (CO2) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo1_sin_datos" [label="Nodo 1 (CO2) sin datos\n[OR-OR] · observable: salud del nodo 1", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "nodo2_apagado" [label="Nodo 2 (Ruido) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo2_sin_datos" [label="Nodo 2 (Ruido) sin datos\n[OR-OR] · observable: salud del nodo 2", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "nodo3_apagado" [label="Nodo 3 (Gas) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo3_sin_datos" [label="Nodo 3 (Gas) sin datos\n[OR-OR] · observable: salud del nodo 3", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "nodo4_apagado" [label="Nodo 4 (Luz) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo4_sin_datos" [label="Nodo 4 (Luz) sin datos\n[OR-OR] · observable: salud del nodo 4", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "nodo5_apagado" [label="Nodo 5 (Conteo térmico) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo5_sin_datos" [label="Nodo 5 (Conteo térmico) sin datos\n[OR-OR] · observable: salud del nodo 5", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "nodo6_apagado" [label="Nodo 6 (Puerta) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo6_sin_datos" [label="Nodo 6 (Puerta) sin datos\n[OR-OR] · observable: salud del nodo 6", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "nodo7_apagado" [label="Nodo 7 (Ambiente) sin batería o apagado\n[salida AND] · inferido", fillcolor="#fde2c4", style="rounded,filled,dashed", penwidth=1];
  "nodo7_sin_datos" [label="Nodo 7 (Ambiente) sin datos\n[OR-OR] · observable: salud del nodo 7", fillcolor="#ffffff", style="rounded,filled,bold", penwidth=2];
  "mayoria_sin_datos" [label="≥ 60 % de los nodos sin datos a la vez\n[N/M≥60%-OR] · inferido", fillcolor="#ffffff", style="rounded,filled,dashed", penwidth=1];
  "algun_nodo_sin_datos" [label="Algún nodo sin datos\n[OR-OR] · inferido", fillcolor="#ffffff", style="rounded,filled,dashed", penwidth=1];
  "sistema_degradado" [label="RA-10 violado: el gemelo no ve todo el aula\n[OR-OR] · observable: ", fillcolor="#f8c9c9", style="rounded,filled,bold", penwidth=3];
  "grafos_desconocidos" [label="Los RA que dependen de esos nodos pasan a 'desconocido'\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "dashboard_incompleto" [label="Dashboard y Gaphor con datos incompletos\n[OR-AND] · inferido", fillcolor="#e8dcf7", style="rounded,filled,dashed", penwidth=1];
  "gateway_caido" -> "nodo1_sin_datos";
  "gateway_caido" -> "nodo2_sin_datos";
  "gateway_caido" -> "nodo3_sin_datos";
  "gateway_caido" -> "nodo4_sin_datos";
  "gateway_caido" -> "nodo5_sin_datos";
  "gateway_caido" -> "nodo6_sin_datos";
  "gateway_caido" -> "nodo7_sin_datos";
  "canal_espnow" -> "nodo1_sin_datos";
  "canal_espnow" -> "nodo2_sin_datos";
  "canal_espnow" -> "nodo3_sin_datos";
  "canal_espnow" -> "nodo4_sin_datos";
  "canal_espnow" -> "nodo5_sin_datos";
  "canal_espnow" -> "nodo6_sin_datos";
  "canal_espnow" -> "nodo7_sin_datos";
  "falla_de_sensor" -> "sistema_degradado";
  "nodo1_apagado" -> "nodo1_sin_datos";
  "nodo1_sin_datos" -> "mayoria_sin_datos";
  "nodo1_sin_datos" -> "algun_nodo_sin_datos";
  "nodo2_apagado" -> "nodo2_sin_datos";
  "nodo2_sin_datos" -> "mayoria_sin_datos";
  "nodo2_sin_datos" -> "algun_nodo_sin_datos";
  "nodo3_apagado" -> "nodo3_sin_datos";
  "nodo3_sin_datos" -> "mayoria_sin_datos";
  "nodo3_sin_datos" -> "algun_nodo_sin_datos";
  "nodo4_apagado" -> "nodo4_sin_datos";
  "nodo4_sin_datos" -> "mayoria_sin_datos";
  "nodo4_sin_datos" -> "algun_nodo_sin_datos";
  "nodo5_apagado" -> "nodo5_sin_datos";
  "nodo5_sin_datos" -> "mayoria_sin_datos";
  "nodo5_sin_datos" -> "algun_nodo_sin_datos";
  "nodo6_apagado" -> "nodo6_sin_datos";
  "nodo6_sin_datos" -> "mayoria_sin_datos";
  "nodo6_sin_datos" -> "algun_nodo_sin_datos";
  "nodo7_apagado" -> "nodo7_sin_datos";
  "nodo7_sin_datos" -> "mayoria_sin_datos";
  "nodo7_sin_datos" -> "algun_nodo_sin_datos";
  "algun_nodo_sin_datos" -> "sistema_degradado";
  "sistema_degradado" -> "grafos_desconocidos";
  "sistema_degradado" -> "dashboard_incompleto";
}